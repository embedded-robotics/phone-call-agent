TRANSPORT_MODE=twilio
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs
TEXT_LOG_FILE=app.log
STRUCTURED_LOG_FILE=app.jsonl
CALL_ARTIFACT_DIR=logs/calls

PUBLIC_BASE_URL=https://example.ngrok-free.app
TWILIO_STREAM_PATH=/twilio/media
MICROPHONE_STREAM_PATH=/microphone/stream
DEFAULT_SYSTEM_PROMPT=You are a helpful phone support agent. Keep replies concise, natural, and safe for a live phone conversation.

DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
UTTERANCE_END_MS=1000
BARGE_IN_RMS_THRESHOLD=900
BARGE_IN_CONSECUTIVE_FRAMES=3

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
